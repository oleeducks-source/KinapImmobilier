# Copier ce fichier en .env (local), ou configurer ces variables dans l'environnement
# Railway / CI correspondant. AUCUNE valeur réelle ici — voir Décision #1 (Phase 2.1).
# Toute variable manquante ou mal formée fait échouer le démarrage : src/config/env.ts

# --- Environnement ---
# development | staging | production
NODE_ENV=development
APP_ENV=development

# --- Base de données ---
# Connexion "pooled" utilisée par l'application à l'exécution
DATABASE_URL=postgresql://user:password@localhost:5432/kinap_dev
# Connexion directe (non poolée), nécessaire pour les migrations Prisma sur certains hébergeurs
DIRECT_DATABASE_URL=postgresql://user:password@localhost:5432/kinap_dev

# --- Session / Auth ---
# Secret aléatoire ≥ 32 octets, généré une fois par environnement, jamais réutilisé entre Dev/Staging/Prod
SESSION_SECRET=

# --- OTP (voir src/server/otp — abstraction OTPProvider) ---
# Provider actif : "twilio" (par défaut, provisoire — Décision #2, Phase 2.1) | "mock" (dev/test uniquement)
OTP_PROVIDER=mock
OTP_TWILIO_ACCOUNT_SID=
OTP_TWILIO_AUTH_TOKEN=
OTP_TWILIO_FROM_NUMBER=

# --- Stockage documentaire (Object Storage S3-compatible — Décision #4, Phase 2.1) ---
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Taille maximale par fichier, en octets (10 Mo par défaut)
STORAGE_MAX_FILE_SIZE_BYTES=10485760

# --- URLs applicatives ---
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Logging ---
LOG_LEVEL=info

# --- Rate limiting (seuils configurables — voir src/lib/rateLimit.ts) ---
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_OTP_MAX_ATTEMPTS=3
RATE_LIMIT_OTP_WINDOW_SECONDS=300
